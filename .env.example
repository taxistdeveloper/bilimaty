# ── Application ──────────────────────────────────────────────
APP_NAME=BILIMATY
# local | production
APP_ENV=local
# Never enable APP_DEBUG in production: it shows exception details.
APP_DEBUG=false
APP_URL=http://collegeos.local
APP_TIMEZONE=Asia/Almaty
# kk | ru
APP_LOCALE=ru

# ── Database (MySQL 8 / MariaDB 10.4+) ───────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=collegeos
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+05:00

# ── Session ──────────────────────────────────────────────────
SESSION_NAME=collegeos_session
# Idle timeout, minutes
SESSION_LIFETIME=30
# true behind HTTPS (also enabled automatically when the request is HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAVE_PATH=

# ── Login rate limiting ──────────────────────────────────────
AUTH_MAX_ATTEMPTS=5
AUTH_MAX_ATTEMPTS_PER_IP=30
AUTH_DECAY_MINUTES=15

# ── First super admin (used by `php cli.php db:seed`) ────────
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=
# Leave empty to generate a random password (printed once in the console)
SEED_ADMIN_PASSWORD=

# ── Several colleges (SaaS): each college has its own database ─
# true: <APP_URL>/<code>/… for colleges, <APP_URL>/platform for the owner
TENANCY=false
PLATFORM_DB_DATABASE=bilimaty_platform
TENANT_DB_PREFIX=bilimaty_
