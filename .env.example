# ── Application ──────────────────────────────────────────────
APP_NAME=BILIMATY
# local | production
APP_ENV=local
# Never enable APP_DEBUG in production: it shows exception details.
APP_DEBUG=false
APP_URL=http://collegeos.local
APP_TIMEZONE=Asia/Almaty
# kk | ru
APP_LOCALE=ru

# ── Database (MySQL 8 / MariaDB 10.4+) ───────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=collegeos
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+05:00

# ── Session ──────────────────────────────────────────────────
SESSION_NAME=collegeos_session
# Idle timeout, minutes
SESSION_LIFETIME=30
# true behind HTTPS (also enabled automatically when the request is HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAVE_PATH=

# ── Login rate limiting ──────────────────────────────────────
AUTH_MAX_ATTEMPTS=5
AUTH_MAX_ATTEMPTS_PER_IP=30
AUTH_DECAY_MINUTES=15

# ── First super admin (used by `php cli.php db:seed`) ────────
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=
# Leave empty to generate a random password (printed once in the console)
SEED_ADMIN_PASSWORD=

# ── Several colleges (SaaS): each college has its own database ─
# true: <APP_URL>/<code>/… for colleges, <APP_URL>/platform for the owner
TENANCY=false
PLATFORM_DB_DATABASE=bilimaty_platform
TENANT_DB_PREFIX=bilimaty_

# ── Assistant voice (Piper: free neural TTS on this server) ──
# Empty PIPER_BIN = the browser's own voice. See README, "Голос ассистента".
PIPER_BIN=
PIPER_VOICE_RU=
PIPER_VOICE_KK=
# kk_KZ-issai-high has 6 speakers: 3 = Raya (female), 1 = Iseke (male), 0 = default (male)
PIPER_SPEAKER_KK=3
# Delivery: tempo (>1 slower), intonation liveliness, rhythm variation, pause between sentences (s)
PIPER_LENGTH_SCALE=1.08
PIPER_NOISE_SCALE=0.75
PIPER_NOISE_W=0.9
PIPER_SENTENCE_SILENCE=0.3

# ── Assistant voice input (Vosk: offline speech recognition on this server) ──
# Empty = the browser's own recognition. Fill with: php cli.php assistant:vosk
VOSK_PYTHON=
VOSK_MODEL_RU=
VOSK_MODEL_KK=
